# PostgreSQL connection string from your hosting provider
DATABASE_URL=postgresql://username:password@host:5432/catatkod
# Comma-separated exact frontend origins; update after deploying the frontend
FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend-domain.example
# Optional. If omitted, the API uses the custom rules pipeline only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=5001
# Optional. Adds SEA-LION to training/benchmark_llm.py and generate_independent_notes.py
SEALION_API_KEY=
